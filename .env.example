# Copy to .env for local use only. Do not commit .env.

FLASK_APP=app
FLASK_DEBUG=1

# Required for secure sessions + credential encryption at rest
SECRET_KEY=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=  # generate with werkzeug; default demo password is "admin"

# Optional: path to SQLite inventory (default: instance/servers.db)
# DATABASE_PATH=

# Demo only: accept unknown SSH host keys (default 0 = reject)
SSH_AUTO_ADD_HOST_KEYS=0
SSH_CONNECT_TIMEOUT=8
